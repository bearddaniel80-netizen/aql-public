#!/usr/local/bin/aql --script

USING "some.aql"

DECLARE csv AS csv('data.csv')
DECLARE some_macro AS SELECT * FROM aggregates

/**
    doc block
    @author: me
    @type: file info
*/

/*
RECURSIVE index_cte AS ( -- inline comment
    SELECT 1 AS id # inline comment
    UNION ALL 
    SELECT id + 1 FROM index_cte WHERE id < 4
), 
*/
WITH some_cte AS (
    some_macro // inline comment
), other_cte AS (
    SELECT age FROM csv # test of inline comment
), log_cte AS (
    SELECT PARSE_KV(line) FROM log('data.log')
), aggregate_cte AS (
    SHOW aggregates
)

# SELECT * FROM aggregate_cte
# SELECT user FROM log_cte WHERE user = 'bob'
SELECT * FROM some_cte